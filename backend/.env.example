DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://ticketera:ticketera@localhost:5432/ticketera
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

TICKET_SIGNING_KEYS=k1:dev-insecure-signing-key
TICKET_SIGNING_KEY_ID=k1
ORDER_HOLD_MINUTES=15

# Sesión del panel (ver apps/accounts/tokens.py) y ventana del escáner del
# personal de seguridad (horas antes del inicio / después del fin del evento).
# JWT_REFRESH_ROTATE_AFTER_SECONDS=43200
# JWT_REFRESH_REUSE_GRACE_SECONDS=120
# CHECKIN_WINDOW_HOURS_BEFORE_START=3
# CHECKIN_WINDOW_HOURS_AFTER_END=0
TERMS_VERSION=2026-01

DEFAULT_FROM_EMAIL=entradas@ticketera.pe
FRONTEND_STORE_URL=http://localhost:3000
FRONTEND_PANEL_URL=http://localhost:3001

# Pasarela activa: fake | mercadopago | izipay | disabled
#
# - fake        no requiere credenciales: todo el flujo de compra funciona de
#               punta a punta en desarrollo (ver §8.2 del plan).
# - mercadopago Checkout Pro sobre la Orders API — ver docs/mercadopago-activacion.md.
# - izipay      formulario incrustado — ver docs/izipay-activacion.md.
# - disabled    bloquea las compras (el frontend avisa de un problema técnico
#               temporal): úsalo si publicas antes de tener la pasarela lista.
PAYMENT_GATEWAY=fake
IZIPAY_SHOP_ID=
IZIPAY_REST_PASSWORD=
IZIPAY_HMAC_SHA256_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_REST_URL=https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment
IZIPAY_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
IZIPAY_MODE=test

# Mercado Pago — Checkout Pro (Orders API). Credenciales de la aplicación del
# ORGANIZADOR que cobra, no del integrador: el dinero entra en la cuenta dueña
# del access token. Ver docs/mercadopago-activacion.md.
# El access token y la clave del webhook son privados: nunca van al frontend
# ni al repositorio.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_PROCESSING_MODE=manual
MERCADOPAGO_CURRENCY=PEN
MERCADOPAGO_MODE=test

AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
