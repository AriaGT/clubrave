DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://ticketera:ticketera@localhost:5432/ticketera
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

TICKET_SIGNING_KEYS=k1:dev-insecure-signing-key
TICKET_SIGNING_KEY_ID=k1
ORDER_HOLD_MINUTES=15

# Sesión del panel (ver apps/accounts/tokens.py) y ventana del escáner del
# personal de seguridad (horas antes del inicio / después del fin del evento).
# JWT_REFRESH_ROTATE_AFTER_SECONDS=43200
# JWT_REFRESH_REUSE_GRACE_SECONDS=120
# CHECKIN_WINDOW_HOURS_BEFORE_START=3
# CHECKIN_WINDOW_HOURS_AFTER_END=0
TERMS_VERSION=2026-01

DEFAULT_FROM_EMAIL=entradas@ticketera.pe
FRONTEND_STORE_URL=http://localhost:3000
FRONTEND_PANEL_URL=http://localhost:3001

# ── Pagos ───────────────────────────────────────────────────────────────────
# Los medios de pago y sus credenciales se configuran desde el panel
# (Ajustes › Configuración avanzada › Medios de pago) y se guardan cifrados
# en la base con esta clave. Obligatoria en producción; en desarrollo se
# deriva de SECRET_KEY si se deja vacía. No la cambies una vez en uso: las
# credenciales guardadas quedarían ilegibles. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYMENT_CREDENTIALS_KEY=

# Constantes técnicas de los proveedores (no son credenciales).
IZIPAY_REST_URL=https://api.micuentaweb.pe/api-payment/V4/Charge/CreatePayment
IZIPAY_JS_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_PROCESSING_MODE=manual
MERCADOPAGO_CURRENCY=PEN

# Heredadas — ya no se leen al cobrar. Solo se importan UNA vez (cifradas) la
# primera vez que el sistema carga la configuración de pagos, para que un
# despliegue que ya cobraba siga cobrando. Después pueden borrarse.
# PAYMENT_GATEWAY=fake | izipay | mercadopago | disabled
# IZIPAY_SHOP_ID= / IZIPAY_PUBLIC_KEY= / IZIPAY_REST_PASSWORD= / IZIPAY_HMAC_SHA256_KEY= / IZIPAY_MODE=
# MERCADOPAGO_ACCESS_TOKEN= / MERCADOPAGO_WEBHOOK_SECRET= / MERCADOPAGO_MODE=

AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
