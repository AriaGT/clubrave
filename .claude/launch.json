{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "organizer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@app/organizer", "dev"],
      "port": 3001
    },
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@app/store", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "python", "manage.py", "runserver", "8000"],
      "port": 8000
    }
  ]
}
