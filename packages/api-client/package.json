{
  "name": "@repo/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos generados desde OpenAPI + un fetcher tipado compartido por ambas apps.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/api/schema/ -o ./src/schema.d.ts --default-non-nullable false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.0"
  }
}
